*.html linguist-vendored
*.html linguist-detectable=false
app/templates/* linguist-vendored
app/templates/** linguist-vendored
app/templates/* linguist-detectable=false
app/templates/** linguist-detectable=false

# 2. Treat static client visualizer assets and third-party libraries as vendored
app/static/* linguist-vendored
app/static/** linguist-vendored

# 3. Mark academic documentation and research artifacts as documentation
docs/* linguist-documentation
docs/** linguist-documentation
RESEARCH_PROJECT_REPORT.md linguist-documentation
*.docx linguist-documentation
*.pdf linguist-documentation
